page Counter "/" {
  state count = 0
  computed double = count * 2

  column gap=4 align=center {
    title "Contador"
    row gap=2 {
      button "-" -> count--
      text count bold
      button "+" primary -> count++
    }
    text `El doble es ${double}` muted
    if count > 5 {
      text "¡Más de 5!"
    }
  }
}
