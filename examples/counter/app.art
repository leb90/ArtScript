page Counter "/" {
  state count = 0
  computed double = count * 2

  column gap=4 align=center {
    title "Counter"
    row gap=2 {
      button "-" -> count--
      text count bold
      button "+" primary -> count++
    }
    text `Double is ${double}` muted
    if count > 5 {
      text "More than 5!"
    }
  }
}
