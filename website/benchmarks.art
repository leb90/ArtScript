// The charts are drawn from the results table the eval writes into the README.
use "./lib/content.ts" { RESULTS, IMPERATIVE, barWidth, resultsHtml, methodologyHtml }

// USD per working result (solved runs / runs): benchmarks/eval/results, checked by tests/website.test.ts.
const NEXT_ROWS = [
  {
    model: "Sonnet 5.5",
    tasks: "All 50 tasks",
    art: "$0.0093 (100/100)",
    next: "$0.0186 (100/100)",
    diff: "−50%",
    react: "$0.0178 (100/100)"
  },
  {
    model: "Sonnet 5.5",
    tasks: "Without a backend (41)",
    art: "$0.0092 (82/82)",
    next: "$0.0170 (82/82)",
    diff: "−46%",
    react: "$0.0162 (82/82)"
  },
  {
    model: "Sonnet 5.5",
    tasks: "Full-stack (9)",
    art: "$0.0095 (18/18)",
    next: "$0.0261 (18/18)",
    diff: "−64%",
    react: "$0.0250 (18/18)"
  },
  {
    model: "Opus 5.5",
    tasks: "All 50 tasks",
    art: "$0.0220 (100/100)",
    next: "$0.0403 (100/100)",
    diff: "−45%",
    react: "$0.0397 (99/99)"
  },
  {
    model: "Opus 5.5",
    tasks: "Without a backend (41)",
    art: "$0.0210 (82/82)",
    next: "$0.0349 (82/82)",
    diff: "−40%",
    react: "$0.0338 (82/82)"
  },
  {
    model: "Opus 5.5",
    tasks: "Full-stack (9)",
    art: "$0.0265 (18/18)",
    next: "$0.0652 (18/18)",
    diff: "−59%",
    react: "$0.0683 (17/17)"
  },
  {
    model: "Haiku 4.5",
    tasks: "All 50 tasks",
    art: "$0.0088 (90/100)",
    next: "$0.0123 (96/100)",
    diff: "−29%",
    react: "$0.0137 (88/100)"
  },
  {
    model: "Haiku 4.5",
    tasks: "Without a backend (41)",
    art: "$0.0068 (77/82)",
    next: "$0.0083 (80/82)",
    diff: "−18%",
    react: "$0.0099 (73/82)"
  },
  {
    model: "Haiku 4.5",
    tasks: "Full-stack (9)",
