use "./lib/content.ts" { DEMOS, EXAMPLES, REPO, lines }

page Examples "/examples" {
  state open = "counter"

  meta title="Examples · ArtScript" description="Complete ArtScript apps, from a counter to a CRM with relations, uploads and live data."
  column class="container page-pad" gap=8 {
    column gap=3 {
      text "Examples" class="crumb"
      title "Complete apps, short files" class="page-title"
      text "Each example is one .art file from the repository. The client-side ones run in the playground; the full-stack ones run with art dev, which also serves their api and database." class="page-lead"
    }
    column gap=3 {
      title "Three apps you can use right now" class="section-title"
      text "Built with the published package and only the spec. They are static demos: the api, accounts and server fns run in your browser (art build --demo), so your data stays with you. The source is in apps/ in the repository." class="page-lead"
      grid cols=1 md:cols=3 gap=5 {
        for d in DEMOS key d.path {
          card class="example demo reveal" gap=3 {
            link href=`/demos/${d.path}/` target="_blank" class="demo-shot" {
              image `/demos/${d.path}.jpg` alt=`${d.title}: a screenshot of the demo`
            }
            text d.title bold large
            text d.summary muted
            row gap=2 wrap align=center {
              link "Open the demo →" href=`/demos/${d.path}/` target="_blank" class="btn primary small"
              link "Source" href=`${REPO}/tree/main/apps/${d.app}` class="pill"
            }
          }
        }
      }
    }
    grid cols=1 md:cols=2 gap=5 {
      for ex in EXAMPLES key ex.name {
        card class="example reveal" gap=3 {
          row justify=between {
            text ex.title bold large
            text `${lines(ex.src)} lines` class="tag"
          }
          text ex.summary muted
          row gap=2 wrap {
            for f in ex.features {
              text f class="tag"
            }
          }
          row gap=2 wrap {
            button open == ex.name ? "Hide code" : "Show code" small class="pill" -> open = open == ex.name ? "" : ex.name
            if ex.runs {
              link "Open in playground" to=`/playground?example=${ex.name}` class="pill"
            } else {
              text `art dev examples/${ex.name}` class="tag"
            }
            link "GitHub" href=`${REPO}/blob/main/examples/${ex.name}/app.art` class="pill"
          }
          if open == ex.name {
            Code src=ex.src lang="art"
          }
        }
      }
    }
  }
}
