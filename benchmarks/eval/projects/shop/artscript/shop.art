model Product {
  id: Number
  name: String
  price: Number
  stock: Number
}

model CartItem {
  product: Product
  qty: Number
}

page Shop "/" {
  state products: Product[] = [{ id: 1, name: "Remera", price: 15, stock: 5 }, { id: 2, name: "Taza", price: 8, stock: 1 }, { id: 3, name: "Gorra", price: 12, stock: 3 }, { id: 4, name: "Mochila", price: 45, stock: 2 }, { id: 5, name: "Lapicera", price: 2, stock: 10 }, { id: 6, name: "Cuaderno", price: 6, stock: 4 }]
  state cart: CartItem[] = []
  state tab = "catalog"
  computed count = cart.reduce((n, i) => n + i.qty, 0)
  fn add(product) {
    let found = cart.find(i => i.product.id == product.id)
    if found {
      found.qty++
    } else {
      cart.push({ product, qty: 1 })
    }
  }
  fn changeQty(id, delta) {
    cart = cart.map(i => i.product.id == id ? { ...i, qty: i.qty + delta } : i).filter(i => i.qty > 0)
  }

  column gap=4 pad=4 {
    Header count=count
    Nav tab=tab onChange=(t => tab = t)
    if tab == "catalog" {
      Catalog products=products onAdd=add
    } else {
      CartView cart=cart onChangeQty=changeQty onClear=(() => cart = [])
    }
    Footer
  }
}
