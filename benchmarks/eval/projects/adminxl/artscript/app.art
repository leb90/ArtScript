model Item {
  id: Number
  name: String
  amount: Number
  active: Bool
}

page Admin "/" {
  state page = "products"

  column gap=4 pad=4 {
    title "Panel" large
    Nav page=page onChange=(p => page = p)
    if page == "products" {
      ProductsPage
    } else if page == "customers" {
      CustomersPage
    } else if page == "orders" {
      OrdersPage
    } else if page == "suppliers" {
      SuppliersPage
    } else if page == "employees" {
      EmployeesPage
    } else if page == "categories" {
      CategoriesPage
    } else if page == "warehouses" {
      WarehousesPage
    } else if page == "invoices" {
      InvoicesPage
    } else if page == "coupons" {
      CouponsPage
    } else if page == "reviews" {
      ReviewsPage
    } else if page == "shipments" {
      ShipmentsPage
    } else if page == "payments" {
      PaymentsPage
    } else if page == "refunds" {
      RefundsPage
    } else if page == "branches" {
      BranchesPage
    } else if page == "vehicles" {
      VehiclesPage
    } else if page == "projects" {
      ProjectsPage
    } else if page == "tickets" {
      TicketsPage
    } else if page == "campaigns" {
      CampaignsPage
    } else if page == "contracts" {
      ContractsPage
    } else if page == "assets" {
      AssetsPage
    } else if page == "expenses" {
      ExpensesPage
    } else if page == "subscriptions" {
      SubscriptionsPage
    } else if page == "partners" {
      PartnersPage
    } else if page == "events" {
      EventsPage
    } else if page == "courses" {
      CoursesPage
    }
  }
}

component Nav(page: String, onChange: Fn) {
  row gap=2 wrap {
    button "Productos" primary=(page == "products") -> onChange("products")
    button "Clientes" primary=(page == "customers") -> onChange("customers")
    button "Pedidos" primary=(page == "orders") -> onChange("orders")
    button "Proveedores" primary=(page == "suppliers") -> onChange("suppliers")
    button "Empleados" primary=(page == "employees") -> onChange("employees")
    button "Categorías" primary=(page == "categories") -> onChange("categories")
    button "Depósitos" primary=(page == "warehouses") -> onChange("warehouses")
    button "Facturas" primary=(page == "invoices") -> onChange("invoices")
    button "Cupones" primary=(page == "coupons") -> onChange("coupons")
    button "Reseñas" primary=(page == "reviews") -> onChange("reviews")
    button "Envíos" primary=(page == "shipments") -> onChange("shipments")
    button "Pagos" primary=(page == "payments") -> onChange("payments")
    button "Devoluciones" primary=(page == "refunds") -> onChange("refunds")
    button "Sucursales" primary=(page == "branches") -> onChange("branches")
    button "Vehículos" primary=(page == "vehicles") -> onChange("vehicles")
    button "Proyectos" primary=(page == "projects") -> onChange("projects")
    button "Tickets" primary=(page == "tickets") -> onChange("tickets")
    button "Campañas" primary=(page == "campaigns") -> onChange("campaigns")
    button "Contratos" primary=(page == "contracts") -> onChange("contracts")
    button "Activos" primary=(page == "assets") -> onChange("assets")
    button "Gastos" primary=(page == "expenses") -> onChange("expenses")
    button "Suscripciones" primary=(page == "subscriptions") -> onChange("subscriptions")
    button "Socios" primary=(page == "partners") -> onChange("partners")
    button "Eventos" primary=(page == "events") -> onChange("events")
    button "Cursos" primary=(page == "courses") -> onChange("courses")
  }
}
