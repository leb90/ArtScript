component ReviewsPage {
  state items: Item[] = [{ id: 1, name: "Alfa", amount: 10, active: true }, { id: 2, name: "Beta", amount: 20, active: true }, { id: 3, name: "Gama", amount: 30, active: false }]
  fn add(name, amount) {
    items.push({ id: Date.now(), name, amount, active: true })
  }

  column gap=2 {
    title "Reseñas"
    ReviewsForm onAdd=add
    ReviewsList items=items
  }
}

component ReviewsList(items: Item[]) {
  if items.length == 0 {
    text "Sin registros" muted
  } else {
    column gap=1 {
      for item in items {
        ReviewsRow item=item
      }
    }
  }
}

component ReviewsRow(item: Item) {
  row gap=2 {
    text item.name bold
    text `Puntaje: ${item.amount}`
  }
}

component ReviewsForm(onAdd: Fn) {
  state name = ""
  state amount = 0
  fn submit() {
    onAdd(name, amount)
    name = ""
    amount = 0
  }

  row gap=2 {
    input name placeholder="Nombre"
    input amount placeholder="Puntaje" type=number
    button "Agregar" primary -> submit()
  }
}
