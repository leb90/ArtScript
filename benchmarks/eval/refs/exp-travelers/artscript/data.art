fn money(n) {
  return `US$ ${n.toLocaleString("es-AR")}`
}

fn day(iso) {
  let [y, m, d] = iso.split("-")
  return `${d}/${m}/${y}`
}

fn initials(name) {
  return name.split(" ").map(w => w[0]).join("")
}

fn hue(name) {
  return [...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 0)
}
