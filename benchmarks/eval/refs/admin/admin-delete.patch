replace CouponsRow
  component CouponsRow(item: Item, onRemove: Fn) {
    row gap=2 {
      text item.name bold
      text `Descuento: ${item.amount}`
      button "Eliminar" small -> onRemove(item.id)
    }
  }
replace CouponsList
  component CouponsList(items: Item[], onRemove: Fn) {
    if items.length == 0 {
      text "Sin registros" muted
    } else {
      column gap=1 {
        for item in items {
          CouponsRow item=item onRemove=onRemove
        }
      }
    }
  }
replace CouponsPage/column/CouponsList
  CouponsList items=items onRemove=(id => items = items.filter(i => i.id != id))
