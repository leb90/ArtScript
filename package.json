{
  "name": "@artscript/core",
  "version": "0.2.5",
  "description": "An AI-native web language that compiles to JavaScript: fewer tokens, less context, fewer errors.",
  "keywords": [
    "artscript",
    "language",
    "compiler",
    "web",
    "ai",
    "llm",
    "reactive",
    "signals"
  ],
  "author": "Leandro Bisceglie",
  "license": "MIT",
  "homepage": "https://github.com/leb90/ArtScript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leb90/ArtScript.git"
  },
  "bugs": {
    "url": "https://github.com/leb90/ArtScript/issues"
  },
  "type": "module",
  "bin": {
    "art": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/compile.d.ts",
      "default": "./lib/compile.js"
    },
    "./runtime": "./runtime/runtime.js"
  },
  "files": [
    "lib",
    "runtime",
    "templates",
    "docs/SPEC.md",
    "docs/SPEC-EDIT.md",
    "llms.txt",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts dev examples/todo",
    "start": "node src/cli.ts dev examples/todo",
    "dev:counter": "node src/cli.ts dev examples/counter",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p .",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "bench": "node src/cli.ts bench",
    "eval": "node benchmarks/eval/run.ts",
    "eval:report": "node benchmarks/eval/report.ts",
    "eval:retries": "node benchmarks/eval/retries.ts",
    "eval:sizes": "node benchmarks/eval/sizes.ts",
    "site": "sh website/build.sh",
    "art": "node src/cli.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-preset-solid": "^1.9.15",
    "happy-dom": "^20.14.5",
    "js-tiktoken": "^1.0.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  }
}
