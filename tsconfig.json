{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "benchmarks/**/*.ts"],
  "exclude": ["tests/fixtures/interop/lib/needs-missing.ts", "benchmarks/eval/next", "benchmarks/eval/refs/*/next", "benchmarks/eval/projects/*/next", "benchmarks/tasks/*/next"]
}
