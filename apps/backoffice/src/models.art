use "./lib/format.ts" { STATUSES, STATUS_OPTIONS, STATUS_FILTER, CATEGORIES, COUNTRIES, formatMoney, formatNumber, formatDate, formatDay, statusLabel, initials }

use "./lib/sample.ts" { samplePlan, freshOrders, statusAfter, SAMPLE_DOMAIN }

model User {
  id: ID
  name: String min=2 max=60
  email: Email unique
  password: String min=8
  role: String = "user"
}

model Customer {
  id: ID
  name: String min=2 max=80
  email: Email unique
  company: String? max=80
  country: String = "United States"
  createdAt: Number = 0
}

model Product {
  id: ID
  name: String min=2 max=80 unique
  category: String
  price: Number min=0
  stock: Number = 0 min=0
}

model Order {
  id: ID
  number: String unique
  customer: Customer cascade
  customerName: String
  product: Product cascade
  quantity: Number min=1
  total: Number min=0
  status: String = "pending"
  createdAt: Number
}

api users: User

api customers: Customer login

api products: Product login

api orders: Order login

auth users

// The dashboard's numbers for the last `days` days, compared with the `days` before them.
server fn stats(days) {
  if !me {
    fail("Log in to see the dashboard", 401)
  }
  let span = [7, 30, 90].includes(days) ? days : 30
  let DAY = 86400000
  let now = Date.now()
  let from = now - span * DAY
  let before = from - span * DAY
  let orders = db.orders.list()
  let customers = db.customers.list()
  let current = orders.filter(o => o.createdAt > from && o.createdAt <= now)
  let previous = orders.filter(o => o.createdAt > before && o.createdAt <= from)
  let kept = list => list.filter(o => o.status != "cancelled")
  let revenue = list => kept(list).reduce((sum, o) => sum + o.total, 0)
  let average = list => kept(list).length == 0 ? 0 : revenue(list) / kept(list).length
  let joined = (a, b) => customers.filter(c => c.createdAt > a && c.createdAt <= b).length
  let change = (value, old) => old == 0 ? null : (value - old) / old * 100
  let points = Array.from({ length: span }, (_, i) => ({ t: from + (i + 1) * DAY, revenue: 0, orders: 0 }))
  for o in kept(current) {
    let p = points[Math.min(span - 1, Math.floor((o.createdAt - from) / DAY))]
    p.revenue += o.total
    p.orders++
  }
  return {
    empty: orders.length == 0 && customers.length == 0 && db.products.count() == 0,
    span,
    revenue: revenue(current),
    revenueChange: change(revenue(current), revenue(previous)),
    orders: current.length,
    ordersChange: change(current.length, previous.length),
    customers: joined(from, now),
    customersChange: change(joined(from, now), joined(before, from)),
    average: average(current),
    averageChange: change(average(current), average(previous)),
    points,
    categories: CATEGORIES.map(name => ({ name, orders: current.filter(o => o.product.category == name).length })),
    statuses: STATUSES.map(name => ({ name, orders: current.filter(o => o.status == name).length }))
  }
}

// Fills an empty workspace with 40 customers, 12 products and 300 orders over the last 90 days.
server fn seed() {
  if !me {
    fail("Log in to load the sample data", 401)
  }
  if db.customers.count() > 0 || db.products.count() > 0 || db.orders.count() > 0 {
    fail("Sample data can only be loaded into an empty workspace", 409)
  }
  let plan = samplePlan(Date.now())
  let customers = []
  let products = []
  try {
    for c in plan.customers {
      customers.push(db.customers.create(c))
    }
    for p in plan.products {
      products.push(db.products.create(p))
    }
    for o in plan.orders {
      let customer = customers[o.customer]
      db.orders.create({ ...o, customer: customer.id, customerName: customer.name, product: products[o.product].id })
    }
  } catch (e) {
    // A server fn is not a transaction: undo what was stored (orders go with their customer).
    for c in customers {
      db.customers.remove(c.id)
    }
    for p in products {
      db.products.remove(p.id)
    }
    fail(`The sample data couldn't be loaded: ${e.message}`, 500)
  }
  return { customers: customers.length, products: products.length, orders: plan.orders.length }
}

// Orders keep the customer's name (the server searches text fields): follow a rename.
server fn renameInOrders(customerId) {
  if !me {
    fail("Log in first", 401)
  }
  let customer = db.customers.get(customerId)
  if !customer {
    return 0
  }
  let stale = db.orders.list({ where: { customer: customerId } }).filter(o => o.customerName != customer.name)
  for o in stale {
    db.orders.update(o.id, { customerName: customer.name })
  }
  return stale.length
}

// Keeps the sample store alive: open orders move on with the days, and when the newest order is
// more than a day old, a few more arrive for the days since. Does nothing in a store without the
// sample customers.
server job refreshSample every "1h" {
  let DAY = 86400000
  let now = Date.now()
  let customers = db.customers.list().filter(c => c.email.endsWith(SAMPLE_DOMAIN))
  let orders = db.orders.list()
  if customers.length == 0 || orders.length == 0 {
    return
  }
  let newest = Math.max(...orders.map(o => o.createdAt))
  if now - newest < DAY {
    return
  }
  for o in orders {
    let status = statusAfter(o.status, (now - o.createdAt) / DAY)
    if status != o.status {
      db.orders.update(o.id, { status })
    }
  }
  let next = 1 + Math.max(1000, ...orders.map(o => Number(o.number.replace("ORD-", "")) || 0))
  for o in freshOrders(now, newest, customers, db.products.list(), next) {
    db.orders.create(o)
  }
}
