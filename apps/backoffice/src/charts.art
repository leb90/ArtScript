use "./lib/chart.ts" { Chart }

// A Chart.js chart that follows its data and the light/dark theme.
// `kind`: "line", "bar" (horizontal) or "doughnut"; `colors`: CSS variables, one per doughnut slice.
component ChartView(kind: String, labels: String[], values: Number[], name: String, colors: String[] = [], currency: Bool = false) {
  ref box
  ref chart
  fn token(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim()
  }
  fn show(value) {
    return currency ? formatMoney(value) : formatNumber(value)
  }
  fn dataset() {
    let main = token("--chart-1")
    let surface = token("--a-surface")
    if kind == "line" {
      return {
        label: name,
        data: values,
        borderColor: main,
        backgroundColor: token("--chart-1-soft"),
        fill: true,
        borderWidth: 2,
        cubicInterpolationMode: "monotone",
        pointRadius: 0,
        pointHoverRadius: 5,
        pointHitRadius: 16,
        pointBackgroundColor: main,
        pointHoverBorderColor: surface,
        pointHoverBorderWidth: 2
      }
    }
    if kind == "bar" {
      return {
        label: name,
        data: values,
        backgroundColor: main,
        borderRadius: 4,
        borderSkipped: "start",
        maxBarThickness: 22
      }
    }
    return {
      label: name,
      data: values,
      backgroundColor: colors.map(token),
      borderColor: surface,
      borderWidth: 2,
      hoverOffset: 4
    }
  }
  fn options() {
    let muted = token("--a-muted")
    let line = token("--chart-grid")
    let tooltip = {
      backgroundColor: token("--tooltip-bg"),
      titleColor: token("--tooltip-fg"),
      bodyColor: token("--tooltip-fg"),
      padding: 10,
      cornerRadius: 8,
      displayColors: kind == "doughnut",
      boxPadding: 4,
      callbacks: { label: item => ` ${kind == "doughnut" ? item.label : name}: ${show(item.raw)}` }
    }
    let base = {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 500 },
      plugins: { legend: { display: false }, tooltip }
    }
    let quiet = { display: false }
    let ticks = { color: muted, font: { size: 12 } }
    if kind == "line" {
      return {
        ...base,
        interaction: { mode: "index", intersect: false },
        scales: {
          x: { grid: quiet, border: quiet, ticks: { ...ticks, maxTicksLimit: 7, maxRotation: 0 } },
          y: {
            beginAtZero: true,
            border: quiet,
            grid: { color: line },
            ticks: {
              ...ticks,
              maxTicksLimit: 5,
              callback: v => currency ? formatMoney(v, true) : formatNumber(v)
            }
          }
        }
      }
    }
    if kind == "bar" {
      return {
        ...base,
        indexAxis: "y",
        scales: {
          x: {
            beginAtZero: true,
            border: quiet,
            grid: { color: line },
            ticks: { ...ticks, maxTicksLimit: 6, precision: 0 }
          },
          y: { grid: quiet, border: quiet, ticks: { ...ticks, color: token("--a-fg") } }
        }
      }
    }
    return { ...base, cutout: "68%" }
  }
  fn paint() {
    if !chart {
      return
    }
    chart.data.labels = labels
    chart.data.datasets = [dataset()]
    chart.options = options()
    chart.update()
  }
  mount {
    chart = new Chart(box, { type: kind, data: { labels, datasets: [dataset()] }, options: options() })
    let system = matchMedia("(prefers-color-scheme: dark)")
    system.addEventListener("change", paint)
    cleanup {
      system.removeEventListener("change", paint)
      chart.destroy()
      chart = null
    }
  }
  effect {
    // Reads what the chart depends on; paints on the next frame, when the theme's CSS is in place.
    let deps = [labels, values, theme()]
    requestAnimationFrame(paint)
  }

  column class="chart-box" {
    canvas ref=box role="img" aria-label=name
  }
}
