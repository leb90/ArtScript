test "signs up and lands on the empty dashboard" {
  open "/"
  see "Welcome back"
  click "Sign up"
  fill "Your name" "Ada Lovelace"
  fill "you@company.com" "ada@northwind.test"
  fill "At least 8 characters" "secret-pass-1"
  click "Create account"
  see "No data yet"
  see "Ada Lovelace"
  see "Admin"
  click "Log out"
  see "Welcome back"
}

test "rejects a wrong password" {
  open "/login"
  click "Sign up"
  fill "Your name" "Ada Lovelace"
  fill "you@company.com" "ada@northwind.test"
  fill "At least 8 characters" "secret-pass-1"
  click "Create account"
  see "No data yet"
  click "Log out"
  fill "you@company.com" "ada@northwind.test"
  fill "At least 8 characters" "not-the-password"
  click "Log in" 1
  see "wrong email or password"
}

test "creates a customer, with errors per field first" {
  open "/login"
  click "Sign up"
  fill "Your name" "Ada Lovelace"
  fill "you@company.com" "ada@northwind.test"
  fill "At least 8 characters" "secret-pass-1"
  click "Create account"
  see "No data yet"
  link "Customers"
  see "No customers found"
  click "New customer"
  fill "Full name" "G"
  fill "name@company.com" "not-an-email"
  click "Save customer"
  see "at least 2 characters"
  see "Enter a valid email address"
  fill "Full name" "Grace Hopper"
  fill "name@company.com" "grace@navy.example"
  click "Save customer"
  see "Customer added"
  see "grace@navy.example"
  see "1 customer"
}

test "adds a product, with errors per field first" {
  open "/login"
  click "Sign up"
  fill "Your name" "Ada Lovelace"
  fill "you@company.com" "ada@northwind.test"
  fill "At least 8 characters" "secret-pass-1"
  click "Create account"
  see "No data yet"
  link "Products"
  see "No products yet"
  click "New product"
  click "Save product"
  see "Enter the product's name"
  see "Enter a price above 0"
  fill "Product name" "Desk Mat"
  fill "Price" "24.5"
  fill "Units" "7"
  click "Save product"
  see "Desk Mat"
  see "$24.50"
  see "Low"
  see "1 product in the catalog"
}

test "loads the sample data and changes an order's status" {
  open "/login"
  click "Sign up"
  fill "Your name" "Ada Lovelace"
  fill "you@company.com" "ada@northwind.test"
  fill "At least 8 characters" "secret-pass-1"
  click "Create account"
  see "No data yet"
  click "Load sample data"
  see "Loaded 300 orders, 40 customers and 12 products"
  see "Average order value"
  see "Orders by status"
  link "Orders"
  see "300 orders match"
  see "ORD-1300"
  fill "Search order or customer" "ORD-1300"
  see "1 order match"
  select 1 "Cancelled"
  see "ORD-1300 is now cancelled"
  select 0 "Cancelled"
  see "ORD-1300"
  select 0 "Pending"
  see "No orders found"
}
