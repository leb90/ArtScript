use "./lib/format.ts" { money, orderNumber, dateText }

layout Main {
  data me = auth.me()
  effect {
    try {
      localStorage.setItem("shop.cart.v1", JSON.stringify(cart))
    } catch (e) {
    }
    // Private mode: the cart lives until the tab closes.
  }
  mount {
    // Another tab changed the cart.
    let sync = e => e.key == "shop.cart.v1" ? cart = savedCart() : null
    window.addEventListener("storage", sync)
    cleanup {
      window.removeEventListener("storage", sync)
    }
  }
  fn logout() {
    await auth.logout()
    notify("You're logged out", "info")
    navigate("/")
  }

  column class="shell" {
    row class="topbar" tag=header {
      row class="topbar-inner" justify=between gap=3 {
        link to="/" class="brand" {
          icon "shopping-bag" size=22
          text "Fernwood" bold
        }
        row class="nav" gap=1 tag=nav aria-label="Main" {
          link "Shop" to="/" class="nav-link"
          if me {
            link "My orders" to="/orders" class="nav-link"
          }
          if me?.role == "admin" {
            link "Admin" to="/admin" class="nav-link"
          }
          if me {
            button "Log out" class="nav-link ghost" -> logout()
          } else {
            link "Log in" to="/login" class="nav-link"
          }
        }
        link to="/cart" class="cart-link" aria-label=`Cart, ${cartCount} ${cartCount == 1 ? "item" : "items"}` {
          icon "shopping-cart" size=18
          text "Cart" class="cart-word"
          for n in [cartCount] key n {
            text `${n}` class=(n > 0 ? "cart-count bump" : "cart-count zero")
          }
        }
      }
    }
    column class="page" tag=main {
      slot
    }
    row class="footer" justify=between wrap gap=2 tag=footer {
      text "Fernwood · Goods for slow days" muted small
      text "A reference app built with ArtScript" muted small
    }
  }
}

component Price(value: Number) {
  text money(value) class="price"
}

component ProductArt(src: String, name: String) {
  image src != "" ? src : "/products/placeholder.svg" alt=name class="art"
}

page NotFound "*" {
  meta title="Page not found · Fernwood"
  column gap=3 align=center class="empty fade-in" {
    icon "help" size=40 muted
    title "We couldn't find that page" tag=h1
    text "The link may be old, or the product may be gone." muted
    link "Back to the shop" to="/" class="btn-link"
  }
}
